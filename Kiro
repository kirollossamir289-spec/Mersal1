function initBible(){
  const book=document.getElementById('bibleBook'); if(!book)return;
  const lang=document.getElementById('bibleLang').value;
  book.innerHTML=bibleBooks.map(b=>`<option value="${b[0]}">${lang==='ar'?b[1]+' — '+b[2]:b[2]+' — '+b[1]}</option>`).join('');
  book.value='John';updateChapterOptions();loadBibleChapter();
}
function updateChapterOptions(){
  const b=bibleBooks.find(x=>x[0]===document.getElementById('bibleBook').value)||bibleBooks[0];
  currentBibleBook=b;
  document.getElementById('bibleChapter').innerHTML=Array.from({length:b[3]},(_,i)=>`<option value="${i+1}">${i+1}</option>`).join('');
}
async function loadBibleBook(){initBible()}
async function loadBibleChapter(){
  const status=document.getElementById('bibleStatus'),list=document.getElementById('verseList');
  if(!status||!list)return;
  const lang=document.getElementById('bibleLang').value;
  const book=bibleBooks.find(x=>x[0]===document.getElementById('bibleBook').value)||bibleBooks[0];
  const chapter=Number(document.getElementById('bibleChapter').value||1);
  status.textContent='جاري تحميل الإصحاح...';list.innerHTML='';
  const base=lang==='ar'
    ?'https://raw.githubusercontent.com/midvash/bible-data/main/versions/ar/svd/books/'
    :'https://raw.githubusercontent.com/midvash/bible-data/main/versions/en/kjv/books/';
  try{
    const res=await fetch(base+book[0]+'.json');
    if(!res.ok)throw new Error('HTTP '+res.status);
    const data=await res.json();
    const ch=data.chapters?.[chapter-1];
    currentBibleVerses=ch?.verses||[];
    renderBibleVerses(currentBibleVerses);
    status.textContent=lang==='ar'?`الكتاب المقدس فان دايك • ${book[1]} ${chapter}`:`King James Version • ${book[2]} ${chapter}`;
  }catch(e){
    status.textContent='';list.innerHTML='<div class="bible-error">تعذر تحميل النص الآن. تأكد من اتصال الإنترنت ثم حاول مرة أخرى.</div>';
  }
}
function renderBibleVerses(arr){
  const lang=document.getElementById('bibleLang').value,book=currentBibleBook;
  selectedBibleVerse=null;
  document.getElementById('bibleActionBar')?.classList.remove('show');
  document.getElementById('verseList').innerHTML=`<div class="bible-chapter">${arr.map(v=>{
    const n=v.number??v.verse??'',text=v.text||v.content||'';
    const ref=`${lang==='ar'?book[1]:book[2]} ${document.getElementById('bibleChapter').value}:${n}`;
    return `<div class="bible-verse ${lang==='en'?'en':''}" data-verse="${escapeAttr(String(n))}" onclick="selectBibleVerse('${escapeAttr(String(n))}')"><span class="num">${n}</span>${escapeHtml(text)}</div>`;
  }).join('')}</div>`;
}
let selectedBibleVerse=null;
function selectBibleVerse(num){
  const v=currentBibleVerses.find(x=>String(x.number??x.verse??'')===String(num));
  if(!v)return;
  selectedBibleVerse=v;
  document.querySelectorAll('.bible-verse').forEach(el=>el.classList.toggle('selected',el.dataset.verse===String(num)));
  document.getElementById('bibleActionBar')?.classList.add('show');
}
