async function addComment(postId){
  const input=document.getElementById('comment-'+postId);const content=(input?.value||'').trim();if(!content)return;
  const {error}=await supabaseClient.from('post_comments').insert({post_id:postId,author_id:userId,content});
  if(error){toast('تعذر إضافة التعليق: '+friendlyAuthError(error));return} input.value='';await renderCommunity();
}
async function renderCommunity(){
  const feed=document.getElementById('communityFeed');if(!feed)return;
  const posts=window.communityPosts||[];
  if(!posts.length){feed.innerHTML='<div class="card"><h3>المجتمع لسه مستني أول مشاركة ✨</h3><p class="muted">ابدأ بأول منشور من زر «منشور جديد».</p></div>';return}
  let likes=[],comments=[];
  try{
    const ids=posts.map(p=>p.id); if(ids.length){
      const [l,c]=await Promise.all([supabaseClient.from('post_likes').select('*').in('post_id',ids),supabaseClient.from('post_comments').select('*').in('post_id',ids).order('created_at',{ascending:true})]);
      likes=l.data||[];comments=c.data||[];
    }
  }catch(e){}
  feed.innerHTML=posts.map(p=>{
    const pl=likes.filter(x=>x.post_id===p.id), pc=comments.filter(x=>x.post_id===p.id);
    const liked=pl.some(x=>x.user_id===userId);
    return `<div class="card post"><div class="post-head"><div class="person" style="border:0;padding:0"><div class="mini">${escapeHtml((p.author_name||'م')[0])}</div><div><b>${escapeHtml(p.author_name||'مستخدم مِرْسَال')}</b><div class="muted">${formatLastUpdate(p.created_at)}</div></div></div>${p.author_id===userId?`<button class="btn secondary" onclick="deletePost('${p.id}')">حذف</button>`:''}</div><p style="white-space:pre-wrap;line-height:1.8">${escapeHtml(p.content||'')}</p><div class="post-actions"><button class="btn ${liked?'gold':'secondary'}" onclick="likePost('${p.id}')">${liked?'❤️':'♡'} ${pl.length}</button><span class="muted">💬 ${pc.length}</span></div>${pc.map(c=>`<div class="comment"><b>${escapeHtml(c.author_name||'مستخدم')}</b> ${escapeHtml(c.content)}</div>`).join('')}<div class="comment-box"><input id="comment-${p.id}" placeholder="اكتب تعليقًا..."><button class="btn secondary" onclick="addComment('${p.id}')">إرسال</button></div></div>`;
  }).join('');
}

/* Scanner */
async function startLinkStudentQR(studentId){
