<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MERSAL | Servant Platform</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
:root{
  --bg:#f5f7f6;--card:#fff;--text:#17231f;--muted:#71807a;--primary:#236b55;
  --primary2:#2f8a6d;--gold:#d6a64f;--line:#e5ebe8;--danger:#b54c4c;
}
*{box-sizing:border-box}
body{margin:0;font-family:"Segoe UI",Tahoma,Arial,sans-serif;background:var(--bg);color:var(--text)}
button,input,textarea,select{font:inherit}button{cursor:pointer}
.app{display:flex;min-height:100vh}
.sidebar{width:260px;background:#173b31;color:#fff;padding:22px 16px;position:fixed;right:0;top:0;bottom:0;z-index:10}
.logo{font-size:26px;font-weight:800;padding:8px 10px 25px}.logo span{color:#e5bc68}
.nav button{width:100%;border:0;background:transparent;color:#dce9e4;padding:13px 14px;border-radius:12px;text-align:right;margin:3px 0}
.nav button:hover,.nav button.active{background:#285b4c;color:#fff}.nav i{display:inline-block;width:28px;font-style:normal}
.main{margin-right:260px;width:calc(100% - 260px);padding:28px;max-width:1500px}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}
.welcome h1{margin:0 0 5px;font-size:28px}.muted{color:var(--muted)}
.avatar{width:46px;height:46px;border-radius:50%;background:#dfeee8;color:#236b55;display:grid;place-items:center;font-weight:800}
.grid{display:grid;gap:18px}.stats{grid-template-columns:repeat(4,1fr)}.two{grid-template-columns:1.25fr .75fr}.three{grid-template-columns:repeat(3,1fr)}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:0 5px 20px #173b3108}
.card h2,.card h3{margin-top:0}
.stat{display:flex;justify-content:space-between;align-items:center}.stat strong{font-size:29px}
.icon{width:45px;height:45px;border-radius:13px;background:#eaf4ef;display:grid;place-items:center;font-size:21px}
.progress{height:10px;background:#edf1ef;border-radius:20px;overflow:hidden}.progress>div{height:100%;background:var(--primary2);border-radius:20px}
.btn{border:0;border-radius:11px;padding:10px 15px;background:var(--primary);color:#fff;font-weight:700}
.btn.secondary{background:#eaf4ef;color:var(--primary)}.btn.gold{background:#f5e8c9;color:#765719}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.between{justify-content:space-between}
.search{display:flex;gap:10px}
.search input,.field input,.field textarea,.field select{width:100%;border:1px solid var(--line);background:#fbfcfb;border-radius:11px;padding:11px 13px;outline:none}
.search input{flex:1}
.lesson{border:1px solid var(--line);border-radius:14px;padding:15px;margin:10px 0}
.lesson .tag{font-size:12px;color:var(--primary);background:#eaf4ef;border-radius:20px;padding:4px 8px}
.verse{background:#f8f1df;border-right:4px solid var(--gold);padding:15px;border-radius:12px;line-height:1.9;margin:10px 0}
.section{display:none}.section.active{display:block}.hide{display:none}
.bible-controls{display:grid;grid-template-columns:1.15fr 1.5fr .7fr;gap:12px}
.bible-chapter{background:#f8f1df;border-radius:16px;padding:18px 20px;line-height:2.15;margin-top:14px;border:1px solid #eadfca}.bible-verse{background:transparent;border:0;padding:5px 2px;margin:0;line-height:2.15;cursor:pointer;transition:background .15s,box-shadow .15s}.bible-verse.selected{background:#fff8e8;box-shadow:0 0 0 2px #e5bc6844;border-radius:10px}.bible-verse.en{direction:ltr;text-align:left;border:0}.bible-verse .num{display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#eaf4ef;color:var(--primary);font-weight:800;margin-left:7px}.bible-verse.en .num{margin-left:0;margin-right:7px}.bible-actionbar{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);display:none;gap:8px;background:#173b31;color:#fff;padding:8px;border-radius:14px;box-shadow:0 12px 35px #173b3140;z-index:40}.bible-actionbar.show{display:flex}.bible-actionbar button{border:0;border-radius:10px;padding:9px 14px;background:#fff;color:#173b31;font-weight:800}.bible-settings{margin-top:18px}
.bible-verse.en{direction:ltr;text-align:left;border-right:0;border-left:4px solid var(--gold)}
.bible-verse .num{display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#eaf4ef;color:var(--primary);font-weight:800;margin-left:7px}
.bible-verse.en .num{margin-left:0;margin-right:7px}
.bible-source{font-size:12px;margin-top:8px}
.bible-error{padding:16px;background:#fff3f3;border:1px solid #f0d5d5;border-radius:12px;color:var(--danger)}
@media(max-width:700px){.bible-controls{grid-template-columns:1fr}}
.tabs{display:flex;gap:8px;margin-bottom:15px;overflow:auto}
.tabs button{border:1px solid var(--line);background:#fff;border-radius:20px;padding:8px 13px;white-space:nowrap}
.tabs button.active{background:#173b31;color:#fff}
.timeline{display:flex;align-items:flex-end;gap:7px;height:180px;border-bottom:1px solid var(--line);padding:15px 8px 0}
.bar{flex:1;background:#7db9a3;border-radius:7px 7px 0 0;min-width:16px;position:relative}
.bar span{position:absolute;bottom:-24px;width:100%;text-align:center;font-size:11px;color:var(--muted)}
.person{display:flex;gap:12px;align-items:center;padding:13px 0;border-bottom:1px solid var(--line)}
.person:last-child{border-bottom:0}.mini{width:38px;height:38px;border-radius:50%;background:#edf4f1;display:grid;place-items:center;color:var(--primary);font-weight:700}
.modal{position:fixed;inset:0;background:#10251e99;display:none;align-items:center;justify-content:center;padding:20px;z-index:20}
.modal.show{display:flex}.modalbox{background:#fff;border-radius:20px;width:min(680px,100%);padding:24px;max-height:90vh;overflow:auto}
.toast{position:fixed;left:24px;bottom:24px;background:#173b31;color:#fff;padding:12px 17px;border-radius:12px;display:none;z-index:50}
.toast.show{display:block}
.account-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:18px}
.profile-head{display:flex;align-items:center;gap:15px;margin-bottom:20px}
.profile-avatar{width:72px;height:72px;border-radius:50%;background:#dfeee8;color:var(--primary);display:grid;place-items:center;font-size:28px;font-weight:800}
.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.info-box{background:#fbfcfb;border:1px solid var(--line);border-radius:13px;padding:13px}
.info-box .label{font-size:12px;color:var(--muted);margin-bottom:5px}
.account-type{display:inline-block;background:#eaf4ef;color:var(--primary);padding:6px 11px;border-radius:20px;font-weight:700;font-size:13px}
.qr-card{text-align:center}
.qr-wrap{display:flex;justify-content:center;align-items:center;background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;margin:15px auto;width:min(270px,100%);min-height:270px}
#qrcode img,#qrcode canvas{margin:auto;display:block}
.qr-id{font-family:monospace;background:#f5f7f6;border:1px solid var(--line);border-radius:9px;padding:8px;word-break:break-all;font-size:12px}
.qr-note{background:#f8f1df;border-right:4px solid var(--gold);padding:12px;border-radius:11px;text-align:right;line-height:1.7;margin-top:15px}
@media(max-width:900px){
  .sidebar{width:76px;padding:15px 8px}.logo{font-size:0;text-align:center}.logo span{font-size:22px}
  .nav button{font-size:0;text-align:center}.nav i{font-size:20px;width:auto}
  .main{margin-right:76px;width:calc(100% - 76px);padding:18px}.stats,.three,.two{grid-template-columns:1fr 1fr}
  .account-grid{grid-template-columns:1fr}
}
@media(max-width:600px){
  .stats,.three,.two{grid-template-columns:1fr}.topbar{align-items:flex-start}.welcome h1{font-size:22px}.main{padding:12px}
  .info-grid{grid-template-columns:1fr}
}
.auth-screen{position:fixed;inset:0;background:var(--bg);display:none;align-items:center;justify-content:center;padding:20px;z-index:100}
.auth-screen.show{display:flex}.auth-box{width:min(480px,100%);background:#fff;border:1px solid var(--line);border-radius:22px;padding:28px;box-shadow:0 15px 50px #173b3114}
.auth-logo{text-align:center;font-size:30px;font-weight:800;color:#173b31;margin-bottom:6px}.auth-logo span{color:#e5bc68}.auth-tabs{display:flex;gap:8px;margin:20px 0}.auth-tabs button{flex:1;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px;font-weight:700}.auth-tabs button.active{background:#173b31;color:#fff}.auth-form{display:none}.auth-form.active{display:block}.auth-error{display:none;background:#fff3f3;color:var(--danger);border:1px solid #f0d5d5;padding:11px;border-radius:11px;margin:12px 0;line-height:1.6}.auth-success{display:none;background:#eef8f2;color:var(--primary);border:1px solid #d7ebdf;padding:11px;border-radius:11px;margin:12px 0;line-height:1.6}.auth-help{font-size:12px;color:var(--muted);line-height:1.7;margin-top:12px}
.logout-btn{background:#fff1f1!important;color:#9b4040!important}
@media(max-width:600px){.auth-box{padding:20px}}

/* MERSAL v2 additions */
.spiritual-checklist{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:18px}
.spiritual-item{display:flex;align-items:center;gap:12px;border:1px solid var(--line);border-radius:14px;padding:15px;background:#fbfcfb}
.spiritual-item input{width:20px;height:20px;accent-color:var(--primary);cursor:pointer}
.spiritual-item small{display:block;color:var(--muted);margin-top:3px}
.post{margin-bottom:16px}.post-head{display:flex;justify-content:space-between;gap:12px;align-items:center}.post-actions{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}.comment-box{display:flex;gap:8px;margin-top:12px}.comment-box input{flex:1;border:1px solid var(--line);border-radius:10px;padding:9px 12px}.comment{padding:8px 0;border-top:1px solid var(--line);font-size:14px}
#qr-reader{border:1px solid var(--line);border-radius:15px;overflow:hidden}
@media(max-width:600px){.spiritual-checklist{grid-template-columns:1fr}}


/* English UI */
/* Dynamic Arabic UI */
body.app-ar{direction:rtl}
body.app-ar .sidebar{left:auto;right:0}
body.app-ar .main{margin-left:0;margin-right:240px}
body.app-ar .qr-note{text-align:right;border-left:0;border-right:4px solid var(--gold)}
body.app-ar .comment-box{direction:rtl}
@media(max-width:900px){
  body.app-ar .main{margin-left:0;margin-right:76px}
}

body{direction:ltr}
.sidebar{left:0;right:auto}
.main{margin-left:240px;margin-right:0}
.qr-note{text-align:left;border-right:0;border-left:4px solid var(--gold)}
.comment-box{direction:ltr}
.scanner-file-row{display:flex;align-items:center;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:14px}
.scanner-file-row input{max-width:280px}
#qr-reader video{max-width:100%}
@media(max-width:900px){
  .main{margin-left:76px;margin-right:0}
}

.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}.calendar-head{font-size:12px;color:var(--muted);text-align:center;font-weight:700;padding:8px}.calendar-day{min-height:100px;border:1px solid var(--line);border-radius:12px;padding:8px;background:#fff;cursor:pointer}.calendar-day.muted-day{opacity:.45}.calendar-day.today{outline:2px solid var(--gold)}.calendar-date{font-weight:800}.calendar-event{margin-top:6px;padding:5px 7px;border-radius:8px;background:#eef6f2;color:var(--primary);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.calendar-event small{display:block;color:var(--muted)}
@media(max-width:700px){.calendar-grid{gap:4px}.calendar-day{min-height:78px;padding:5px}.calendar-event{font-size:10px}}
</style>
</head>

<body>
<div class="auth-screen" id="authScreen">
  <div class="auth-box">
    <div class="auth-logo">مِرْسَال <span>✦</span></div>
    <div class="muted" style="text-align:center">منصة الخادم — سجّل دخولك للوصول إلى حسابك</div>
    <div class="auth-tabs">
      <button id="loginTab" class="active" onclick="switchAuth('login')">تسجيل الدخول</button>
      <button id="signupTab" onclick="switchAuth('signup')">إنشاء حساب</button>
    </div>
    <div id="authError" class="auth-error"></div>
    <div id="authSuccess" class="auth-success"></div>
    <form id="loginForm" class="auth-form active" onsubmit="login(event)">
      <div class="field"><label>البريد الإلكتروني</label><input id="loginEmail" type="email" autocomplete="email" required placeholder="name@example.com"></div><br>
      <div class="field"><label>كلمة المرور</label><input id="loginPassword" type="password" autocomplete="current-password" required placeholder="••••••••"></div><br>
      <div class="field"><label>نوع الحساب</label><select id="loginRole"><option value="leader">قائد</option><option value="scout">كشاف</option></select></div><br>
      <button class="btn" style="width:100%" type="submit">دخول</button>
    </form>
    <form id="signupForm" class="auth-form" onsubmit="signup(event)">
      <div class="field"><label>الاسم</label><input id="signupName" required placeholder="اسمك بالكامل"></div><br>
      <div class="field"><label>البريد الإلكتروني</label><input id="signupEmail" type="email" autocomplete="email" required placeholder="name@example.com"></div><br>
      <div class="field"><label>كلمة المرور</label><input id="signupPassword" type="password" minlength="6" autocomplete="new-password" required placeholder="6 أحرف أو أكثر"></div><br>
      <div class="field"><label>أنا</label><select id="signupRole" required><option value="leader">قائد</option><option value="scout">كشاف</option></select></div><br>
      <div class="field"><label>المرحلة العمرية</label><select id="signupAge"><option>ابتدائي</option><option>إعدادي</option><option>ثانوي</option><option>شباب</option></select></div><br>
      <button class="btn" style="width:100%" type="submit">إنشاء الحساب</button>
    </form>
    <div class="auth-help">يتم حفظ بيانات الحساب في Supabase. لا تضع داخل هذا الملف أي مفتاح Secret أو service_role.</div>
  </div>
</div>

<div class="app" id="appShell">
<aside class="sidebar">
  <div class="logo">مِرْسَال <span>✦</span></div>
  <div class="nav">
    <button class="active" onclick="show('dashboard',this)"><i>⌂</i> الرئيسية</button>
    <button onclick="show('prep',this)"><i>✎</i> مستر التحضير</button>
    <button onclick="show('bible',this)"><i>✝</i> الكتاب المقدس</button>
    <button onclick="show('spiritual',this)"><i>♡</i> حياتي الروحية</button>
    <button onclick="show('calendar',this)"><i>▣</i> التقويم</button>
    <button onclick="show('network',this)"><i>◎</i> شبكة الخدام</button>
    <button id="navStudents" onclick="show('students',this)"><i>♙</i> المخدومين</button>
    <button id="navAttendance" onclick="show('attendance',this)"><i>📷</i> الحضور والـQR</button>
    <button onclick="show('account',this)"><i>👤</i> حسابي</button>
  </div>
</aside>
<main class="main">

<section id="dashboard" class="section active">
  <div class="topbar">
    <div class="welcome"><h1 id="dashboardWelcome">صباح الخير يا خادم 👋</h1><div class="muted">خلّي كلمتك جاهزة… وخلّي قلبك جاهز أكتر.</div></div>
    <div class="avatar" id="topAvatar">م</div>
  </div>
  <div class="grid stats">
    <div class="card stat"><div><div class="muted">تحضيراتك</div><strong id="prepCount">0</strong></div><div class="icon">✎</div></div>
    <div class="card stat"><div><div class="muted">Streak</div><strong id="dashboardStreak">0 🔥</strong></div><div class="icon">🔥</div></div>
    <div class="card stat"><div><div class="muted">آيات محفوظة</div><strong id="savedNoteCount">0</strong></div><div class="icon">✝</div></div>
    <div class="card stat"><div><div class="muted">مخدومين</div><strong id="dashboardStudentCount">0</strong></div><div class="icon">♙</div></div>
  </div><br>
  <div class="grid two">
    <div class="card">
      <div class="row between"><h2>كمّل من حيث توقفت</h2><button class="btn secondary" onclick="show('prep')">كل التحضيرات</button></div>
      <div id="dashboardLessons"><div class="muted" style="padding:15px 0">جاري تحميل تحضيراتك...</div></div>
    </div>
    <div class="card"><h2>آية اليوم</h2><div class="verse">«أَنَا هُوَ الطَّرِيقُ وَالْحَقُّ وَالْحَيَاةُ»<br><small>يوحنا 14: 6</small></div><button class="btn gold" onclick="saveNote('يوحنا 14:6')">أضف تأمل ✦</button></div>
  </div><br>
  <div class="grid two">
    <div class="card"><h2>رحلتك الروحية هذا الأسبوع</h2><div class="progress"><div style="width:72%"></div></div><p class="muted">72% من هدفك الأسبوعي</p><div class="row"><button class="btn" onclick="show('spiritual')">متابعة التقدم</button><button class="btn secondary" onclick="addActivity()">+ نشاط روحي</button></div></div>
    <div class="card"><h2>تذكير للخدمة</h2><p id="serviceReminder">جاري حساب المتابعة...</p><button class="btn" onclick="show('students')">متابعة المخدومين</button></div>
  </div>
</section>

<section id="prep" class="section">
  <div class="topbar"><div><h1>مِستر التحضير ✎</h1><div class="muted">حضّر أسرع، شارك، وابحث في تحضيرات الخدام.</div></div><button class="btn" onclick="newPrep()">+ تحضير جديد</button></div>
  <div class="card">
    <div class="search"><input id="topicSearch" placeholder="ابحث عن Topic مثل: الصلاة، المحبة، الغفران..." oninput="filterLessons()"><button class="btn" onclick="filterLessons()">بحث</button></div>
    <div class="tabs"><button class="active">كل الأعمار</button><button>ابتدائي</button><button>إعدادي</button><button>ثانوي</button><button>شباب</button></div>
    <div id="lessonList"></div>
  </div><br>
  <div class="grid two">
    <div class="card"><h2>اقتراحات موثوقة</h2>
      <div class="lesson"><b>عظة: كيف نعيش الإيمان عمليًا؟</b><p class="muted">محتوى مقترح • 18 دقيقة</p><button class="btn secondary" onclick="toast('تم حفظ الفيديو للمشاهدة لاحقًا')">حفظ</button></div>
      <div class="lesson"><b>تأمل: الغفران</b><p class="muted">تأمل روحي • 11 دقيقة</p><button class="btn secondary" onclick="toast('تم حفظ التأمل')">حفظ</button></div>
    </div>
    <div class="card"><h2>أدوات جذب المخدوم</h2><p>أسئلة افتتاحية، ألعاب تعليمية، أمثلة من الحياة، وطرق تبسيط الموضوع.</p><div class="row"><button class="btn secondary" onclick="toast('تم توليد مجموعة أسئلة افتتاحية')">أسئلة افتتاحية</button><button class="btn secondary" onclick="toast('تم حفظ أفكار النشاط')">أفكار نشاط</button></div></div>
  </div>
</section>

<section id="bible" class="section">
  <div class="topbar"><div><h1>الكتاب المقدس ✝</h1><div class="muted">الكتاب المقدس كاملًا بالعربية والإنجليزية — فان دايك وKing James Version.</div></div></div>
  <div class="card">
    <div class="bible-controls">
      <div class="field"><label>اللغة / الترجمة</label><select id="bibleLang" onchange="loadBibleBook()"><option value="ar">العربية — فان دايك</option><option value="en">English — King James Version</option></select></div>
      <div class="field"><label>السفر</label><select id="bibleBook" onchange="updateChapterOptions();loadBibleChapter()"></select></div>
      <div class="field"><label>الإصحاح</label><select id="bibleChapter" onchange="loadBibleChapter()"></select></div>
    </div>
    <div class="search" style="margin-top:14px"><input id="verseSearch" placeholder="ابحث داخل الإصحاح عن كلمة أو رقم آية..." oninput="filterBibleVerses()"><button class="btn" onclick="filterBibleVerses()">بحث</button></div>
    <div id="bibleStatus" class="muted" style="margin-top:14px">جاري تحميل الكتاب المقدس...</div>
    <div id="bibleActionBar" class="bible-actionbar"><button onclick="copySelectedVerse()">نسخ</button><button onclick="reflectSelectedVerse()">تأمل</button><button onclick="clearBibleSelection()">إلغاء</button></div>
    <div id="verseList"></div>
  </div>
</section>

<section id="spiritual" class="section">
  <div class="topbar"><div><h1>حياتي الروحية ♡</h1><div class="muted">سجّل خطواتك الروحية اليومية وتابع استمراريتك.</div></div></div>
  <div class="grid stats">
    <div class="card stat"><div><div class="muted">Streak الحالي</div><strong id="spiritualStreak">0 🔥</strong></div></div>
