const APP_ARABIC=Object.fromEntries(
  Object.entries(APP_TRANSLATIONS).map(([ar,en])=>[en,ar])
);

function replaceTextNodes(root, dict){
  const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
  const nodes=[];
  while(walker.nextNode()) nodes.push(walker.currentNode);
  nodes.forEach(n=>{
    const raw=n.nodeValue;
    const trimmed=raw.trim();
    if(!trimmed) return;
    if(dict[trimmed]) n.nodeValue=raw.replace(trimmed,dict[trimmed]);
  });
}

function setAppLanguage(lang){
  lang = lang==='ar' ? 'ar' : 'en';
  localStorage.setItem(APP_LANG_KEY,lang);
  document.documentElement.lang=lang;
  document.documentElement.dir=lang==='ar'?'rtl':'ltr';
  document.body.classList.toggle('app-ar',lang==='ar');

  // Translate in both directions. Bible content is deliberately excluded.
  replaceTextNodes(document.body, lang==='en' ? APP_TRANSLATIONS : APP_ARABIC);

  document.querySelectorAll('input[placeholder],textarea[placeholder]').forEach(el=>{
    const p=el.getAttribute('placeholder');
    const mapped=(lang==='en'?APP_TRANSLATIONS:APP_ARABIC)[p];
    if(mapped) el.setAttribute('placeholder',mapped);
  });

  document.querySelectorAll('option').forEach(el=>{
    const raw=el.textContent.trim();
    const mapped=(lang==='en'?APP_TRANSLATIONS:APP_ARABIC)[raw];
    if(mapped) el.textContent=mapped;
  });

  const a=document.getElementById('langArabicBtn'),e=document.getElementById('langEnglishBtn');
  if(a&&e){
    a.classList.toggle('gold',lang==='ar');
    a.classList.toggle('secondary',lang!=='ar');
    e.classList.toggle('gold',lang==='en');
    e.classList.toggle('secondary',lang!=='en');
  }
}

function initAppLanguage(){
  const saved=localStorage.getItem(APP_LANG_KEY)||'en';
  setAppLanguage(saved);
}

// Start authentication after the DOM exists. The previous build defined initAuth()
// but never called it, which left the login screen hidden.
window.addEventListener('DOMContentLoaded', ()=>{
  initAppLanguage();
  initAuth();
});
