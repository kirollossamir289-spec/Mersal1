    "تم قراءة QR، لكن هذا المخدوم غير موجود ضمن قائمتك.":"QR scanned, but this student is not in your list.",
    "المخدوم ليس ضمن قائمتك":"This student is not in your list","تم تسجيل حضور ":"Attendance recorded for ",
    "لا يوجد حضور مسجل اليوم بعد.":"No attendance recorded today yet.","شغّل SQL الخاص بالمجتمع ثم أعد تحميل الصفحة.":"Run the community SQL, then reload the page.",
    "نوع الحساب المختار (":"Selected account type (",") لا يطابق نوع الحساب المسجل لهذا البريد.":" ) does not match the account type registered for this email.",
    "تم حفظ البيانات ✨":"Details saved ✨",
    "ماذا تريد أن تشارك اليوم؟":"What would you like to share today?",
    "أندرو":"Andrew"
  };

  function shouldSkip(el){
    return el.closest('script,style,#verseList,#bibleBook') ||
      el.closest('#bibleStatus')?.matches('#bibleStatus');
  }
  function translateTextNode(node){
    const el=node.parentElement;
    if(!el || shouldSkip(el)) return;
    let s=node.nodeValue;
    let out=s;
    for(const [a,b] of Object.entries(T)){
      if(out.includes(a)) out=out.split(a).join(b);
    }
    if(out!==s) node.nodeValue=out;
  }
  function translateAttrs(el){
    if(el.matches('input,textarea,button,select,option')) {
      ['placeholder','title','aria-label'].forEach(attr=>{
        const v=el.getAttribute(attr);
        if(!v)return;
        let o=v;
        for(const [a,b] of Object.entries(T)) if(o.includes(a)) o=o.split(a).join(b);
        if(o!==v)el.setAttribute(attr,o);
      });
    }
  }
  function translate(root=document){
    const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
    const nodes=[]; let n;
    while(n=walker.nextNode()) nodes.push(n);
    nodes.forEach(translateTextNode);
    root.querySelectorAll?.('input,textarea,button,select,option').forEach(translateAttrs);
  }
  window.MERSAL_TRANSLATE=translate;
  document.addEventListener('DOMContentLoaded',()=>{
    translate(document);
    const obs=new MutationObserver(muts=>muts.forEach(m=>{
      m.addedNodes.forEach(x=>{if(x.nodeType===1)translate(x);else if(x.nodeType===3)translateTextNode(x);});
    }));
    obs.observe(document.body,{childList:true,subtree:true});
  });
})();

