async function startScanner(){
  if(!isLeader()){toast('The scanner is available to leaders only');return}
  if(scannerRunning)return;
  if(typeof Html5Qrcode==='undefined'){toast('QR Scanner library failed to load');return}
  const reader=document.getElementById('qr-reader');
  if(!reader){toast('Scanner area not found');return}
  if(!window.isSecureContext && location.hostname!=='localhost' && location.hostname!=='127.0.0.1'){
    document.getElementById('scannerStatus').textContent='Camera scanning requires HTTPS. Open the published HTTPS site and allow camera access.';
    toast('Camera scanning requires HTTPS');
    return;
  }
  try{
    if(scannerInstance){try{await scannerInstance.clear()}catch(e){}}
    scannerInstance=new Html5Qrcode('qr-reader');
    const cameras=await Html5Qrcode.getCameras();
    if(!cameras?.length) throw new Error('No camera found');
    const preferred=cameras.find(c=>/back|rear|environment/i.test(c.label))||cameras[0];
    await scannerInstance.start(
      preferred.id,
      {fps:10,qrbox:{width:250,height:250},aspectRatio:1.0},
      onQrSuccess,
      ()=>{}
    );
    scannerRunning=true;
    document.getElementById('scannerStatus').textContent='Point the camera at the student QR code...';
  }catch(e){
    scannerRunning=false;
    try{await scannerInstance?.clear()}catch(_){}
    scannerInstance=null;
    document.getElementById('scannerStatus').textContent='Could not start the camera. Allow camera access and use the HTTPS version of the site.';
    toast('Camera could not start. Check HTTPS and camera permission.');
  }
}
async function stopScanner(){
  if(scannerInstance){
    try{if(scannerRunning) await scannerInstance.stop()}catch(e){}
    try{await scannerInstance.clear()}catch(e){}
  }
  scannerRunning=false;scannerInstance=null;
  const s=document.getElementById('scannerStatus');if(s)s.textContent='Scanner stopped.';
}
async function scanQrImage(file){
  if(!file)return;
  if(typeof Html5Qrcode==='undefined'){toast('QR Scanner library failed to load');return}
  const reader=document.getElementById('qr-reader');
  try{
    const scanner=new Html5Qrcode('qr-reader');
    const decoded=await scanner.scanFile(file,true);
    try{await scanner.clear()}catch(_){}
    await onQrSuccess(decoded);
  }catch(e){
    toast('Could not read a QR code from that image.');
    document.getElementById('scannerStatus').textContent='No readable QR code found in the selected image.';
  }
}
async function renderAttendanceDashboard(){
  if(!isServant())return;
