/* Bible: single-tap verse selection with optional multi-verse range. */
let selectedBibleIndices=[];
function renderBibleVerses(arr){
  const lang=document.getElementById('bibleLang').value,book=currentBibleBook;
  document.getElementById('verseList').innerHTML=`<div class="bible-chapter">${arr.map((v,i)=>{
    const n=String(v.number??v.verse??''), text=v.text||v.content||'';
    const originalIndex=currentBibleVerses.findIndex(x=>String(x.number??x.verse??'')===n);
    return `<div class="bible-verse selectable-verse ${lang==='en'?'en':''}" data-index="${originalIndex}" data-verse="${escapeAttr(n)}" onclick="tapBibleVerse(${originalIndex})"><span class="num">${escapeHtml(n)}</span><span class="verse-text">${escapeHtml(text)}</span></div>`;
  }).join('')}</div>`;
  applyBibleSelectionUI();
}
function tapBibleVerse(index){
  if(index<0 || !currentBibleVerses[index])return;
  if(selectedBibleIndices.length===0){
    selectedBibleIndices=[index];
  }else if(selectedBibleIndices.length===1 && selectedBibleIndices[0]!==index){
    const a=selectedBibleIndices[0], b=index, lo=Math.min(a,b), hi=Math.max(a,b);
    selectedBibleIndices=Array.from({length:hi-lo+1},(_,k)=>lo+k);
  }else if(selectedBibleIndices.includes(index)){
    selectedBibleIndices=selectedBibleIndices.filter(i=>i!==index);
  }else{
    const all=[...selectedBibleIndices,index].sort((a,b)=>a-b);
    const lo=all[0],hi=all[all.length-1];
    selectedBibleIndices=Array.from({length:hi-lo+1},(_,k)=>lo+k);
  }
  applyBibleSelectionUI();
}
function applyBibleSelectionUI(){
  document.querySelectorAll('.selectable-verse').forEach(el=>el.classList.toggle('selected',selectedBibleIndices.includes(Number(el.dataset.index))));
  document.getElementById('bibleActionBar')?.classList.toggle('show',selectedBibleIndices.length>0);
}
function getSelectedBibleData(){
  const items=selectedBibleIndices.map(i=>currentBibleVerses[i]).filter(Boolean);
  if(!items.length)return null;
  const lang=document.getElementById('bibleLang').value, book=currentBibleBook, chapter=document.getElementById('bibleChapter').value;
  const nums=items.map(v=>Number(v.number??v.verse??0)).filter(Boolean).sort((a,b)=>a-b);
  const text=items.map(v=>v.text||v.content||'').join('\n');
  const ref=`${lang==='ar'?book[1]:book[2]} ${chapter}:${nums.length===1?nums[0]:`${nums[0]}-${nums[nums.length-1]}`}`;
  return {text,ref};
}
function clearBibleSelection(){selectedBibleIndices=[];applyBibleSelectionUI()}
function copySelectedVerse(){const d=getSelectedBibleData();if(!d)return;copyBibleVerse(d.text)}
function reflectSelectedVerse(){const d=getSelectedBibleData();if(d)saveNote(d.ref)}
function filterBibleVerses(){
  const q=(document.getElementById('verseSearch').value||'').trim().toLowerCase();
  if(!q){renderBibleVerses(currentBibleVerses);return}
  renderBibleVerses(currentBibleVerses.filter(v=>String(v.number??v.verse??'').includes(q)||(v.text||v.content||'').toLowerCase().includes(q)));
}
function copyBibleVerse(text){
  if(navigator.clipboard?.writeText) navigator.clipboard.writeText(text);
  else{const ta=document.createElement('textarea');ta.value=text;document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove()}
  toast('تم نسخ الآية');
}

/* Spiritual notebook */
function renderSpiritualChecklist(){
  const box=document.getElementById('spiritualChecklist'); if(!box)return;
  const today=localDateKey(new Date());
  const items=window.spiritualActivities||[];
  const todayTypes=new Set(items.filter(x=>x.activity_date===today).map(x=>x.activity_type));
  const label=document.getElementById('spiritualTodayLabel'); if(label)label.textContent=new Date().toLocaleDateString('ar-EG',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
  box.innerHTML=SPIRITUAL_TYPES.map(([type,label])=>{
    const checked=todayTypes.has(type);
    return `<label class="spiritual-item"><input type="checkbox" ${checked?'checked':''} onchange="toggleSpiritual('${type}',this.checked)"><span><b>${label}</b><small>${checked?'تم تسجيله اليوم':'اضغط للتسجيل'}</small></span></label>`;
  }).join('');
}
async function toggleSpiritual(type,checked){
  const today=localDateKey(new Date());
  if(checked){
    const {error}=await supabaseClient.from('spiritual_activities').insert({user_id:userId,activity_type:type,activity_date:today,notes:''});
    if(error){toast('تعذر حفظ النشاط: '+friendlyAuthError(error));renderSpiritualChecklist();return}
  }else{
    const {error}=await supabaseClient.from('spiritual_activities').delete().eq('user_id',userId).eq('activity_type',type).eq('activity_date',today);
    if(error){toast('تعذر تعديل النشاط: '+friendlyAuthError(error));renderSpiritualChecklist();return}
  }
  await loadSpiritual();renderSpiritualChecklist();renderChart();
}

/* Community */
async function loadCommunity(){
  if(!supabaseClient||!currentUser)return;
  const {data,error}=await supabaseClient.from('posts').select('*').order('created_at',{ascending:false}).limit(50);
  if(error){const el=document.getElementById('communityFeed');if(el)el.innerHTML=`<div class="card"><p class="muted">تعذر تحميل المجتمع. لو لم تُشغّل SQL الخاص بالمجتمع بعد، شغّله أولًا.</p></div>`;return}
  window.communityPosts=data||[];
  renderCommunity();
}
function openNewPost(){document.getElementById('postComposer')?.classList.remove('hide');document.getElementById('newPostText')?.focus()}
function closePostComposer(){document.getElementById('postComposer')?.classList.add('hide');if(document.getElementById('newPostText'))document.getElementById('newPostText').value=''}
async function createPost(){
  const content=(document.getElementById('newPostText')?.value||'').trim();
  if(!content){toast('اكتب المنشور أولًا');return}
  const {error}=await supabaseClient.from('posts').insert({author_id:userId,content});
  if(error){toast('تعذر نشر المنشور: '+friendlyAuthError(error));return}
  closePostComposer();await loadCommunity();toast('تم نشر المنشور ✨');
}
async function likePost(postId){
  const {data}=await supabaseClient.from('post_likes').select('post_id').eq('post_id',postId).eq('user_id',userId).maybeSingle();
  if(data) await supabaseClient.from('post_likes').delete().eq('post_id',postId).eq('user_id',userId);
  else await supabaseClient.from('post_likes').insert({post_id:postId,user_id:userId});
  renderCommunity();
}
async function deletePost(postId){
  const post=(window.communityPosts||[]).find(p=>p.id===postId);
  if(!post || post.author_id!==userId){toast('يمكنك حذف منشوراتك أنت فقط');return}
  if(!confirm(document.documentElement.lang==='ar'?'هل تريد حذف هذا المنشور؟':'Delete this post?'))return;
  const {error}=await supabaseClient.from('posts').delete().eq('id',postId).eq('author_id',userId);
  if(error){toast('تعذر حذف المنشور: '+friendlyAuthError(error));return}
  await loadCommunity();toast(document.documentElement.lang==='ar'?'تم حذف المنشور':'Post deleted');
