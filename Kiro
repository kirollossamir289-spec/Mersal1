<script>
/* =========================================================
   MERSAL — Supabase-connected frontend
   No demo records are used for students, lessons, notes,
   spiritual activities, or attendance.
   ========================================================= */

const SUPABASE_URL = "https://wcaodvafxmmlftltwvlo.supabase.co";
const SUPABASE_KEY = "sb_publishable_YrlpxONuTM1EZ1bt2J0O0A_2IuNTTCU";

let supabaseClient = null;
let currentUser = null;
let account = {name:"",type:"leader",age:"",church:"",service:"",email:""};
let userId = "";
let lessons = [];
let students = [];
let currentBibleVerses = [];
let currentBibleBook = null;

function normalizeRole(role){
  const r=String(role||'').trim().toLowerCase();
  if(['leader','قائد','خادم','servant'].includes(r)) return 'leader';
  if(['scout','كشاف','مخدوم','member','student'].includes(r)) return 'scout';
  return 'leader';
}
function isLeader(){return normalizeRole(account?.type)==='leader'}
function roleLabel(role=account?.type){
  const r=normalizeRole(role); return document.documentElement.lang==='ar'?(r==='leader'?'قائد':'كشاف'):(r==='leader'?'Leader':'Scout');
}

function isSupabaseConfigured(){
  return SUPABASE_URL.startsWith("https://") &&
    !SUPABASE_URL.includes("YOUR_SUPABASE") &&
    SUPABASE_KEY && !SUPABASE_KEY.includes("YOUR_SUPABASE");
}

if(isSupabaseConfigured() && window.supabase){
  supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
}

function setAuthMessage(type,msg){
  const e=document.getElementById('authError'), s=document.getElementById('authSuccess');
  e.style.display='none'; s.style.display='none';
  if(type==='error'){e.textContent=msg;e.style.display='block'}
  if(type==='success'){s.textContent=msg;e.style.display='block'}
}

function switchAuth(mode){
  document.getElementById('loginTab').classList.toggle('active',mode==='login');
  document.getElementById('signupTab').classList.toggle('active',mode==='signup');
  document.getElementById('loginForm').classList.toggle('active',mode==='login');
  document.getElementById('signupForm').classList.toggle('active',mode==='signup');
  setAuthMessage('','');
}
function showAuthScreen(){
  document.getElementById('authScreen').classList.add('show');
  document.getElementById('appShell').style.display='none';
}
function hideAuthScreen(){
  document.getElementById('authScreen').classList.remove('show');
  document.getElementById('appShell').style.display='flex';
}
function friendlyAuthError(error){
  const msg=error?.message||String(error||'حدث خطأ غير معروف');
  const low=msg.toLowerCase();
  if(low.includes('invalid login credentials')) return 'البريد الإلكتروني أو كلمة المرور غير صحيحة.';
  if(low.includes('user already registered')) return 'هذا البريد الإلكتروني مسجل بالفعل. جرّب تسجيل الدخول.';
  if(low.includes('email not confirmed')) return 'الحساب لم يتم تأكيد بريده الإلكتروني بعد. افتح رسالة التأكيد التي أرسلها Supabase.';
  if(low.includes('relation') && low.includes('profiles')) return 'جدول profiles غير موجود. نفّذ SQL الخاص بـ Mersal أولًا.';
  if(low.includes('relation') && low.includes('students')) return 'جدول students غير موجود. نفّذ SQL الخاص بـ Mersal أولًا.';
  if(low.includes('relation') && low.includes('lessons')) return 'جدول lessons غير موجود. نفّذ SQL الخاص بـ Mersal أولًا.';
  if(low.includes('relation') && low.includes('spiritual_activities')) return 'جدول spiritual_activities غير موجود. نفّذ SQL الخاص بـ Mersal أولًا.';
  if(low.includes('relation') && low.includes('notes')) return 'جدول notes غير موجود. نفّذ SQL الخاص بـ Mersal أولًا.';
  if(low.includes('relation') && low.includes('attendance')) return 'جدول attendance غير موجود. نفّذ SQL الخاص بـ Mersal أولًا.';
  if(low.includes('permission denied') || low.includes('row-level security') || low.includes('violates row-level security'))
    return 'تم رفض العملية بسبب صلاحيات قاعدة البيانات (RLS). راجع سياسات Mersal التي تم تنفيذها في Supabase.';
  return msg;
}

async function login(event){
  event.preventDefault();
  if(!supabaseClient){setAuthMessage('error','لم يتم إعداد Supabase.');return}
  const email=document.getElementById('loginEmail').value.trim();
  const password=document.getElementById('loginPassword').value;
  setAuthMessage('','');
  const {data,error}=await supabaseClient.auth.signInWithPassword({email,password});
  if(error){setAuthMessage('error',friendlyAuthError(error));return}
  currentUser=data.user;
  try{
    await loadProfile();
    hideAuthScreen();
    await loadAllData();
    toast('تم تسجيل الدخول بنجاح 👋');
  }catch(e){setAuthMessage('error',friendlyAuthError(e))}
}

async function signup(event){
  event.preventDefault();
  if(!supabaseClient){setAuthMessage('error','لم يتم إعداد Supabase.');return}
  const name=document.getElementById('signupName').value.trim();
  const email=document.getElementById('signupEmail').value.trim();
  const password=document.getElementById('signupPassword').value;
  const role=document.getElementById('signupRole').value;
  const age=document.getElementById('signupAge').value;
  setAuthMessage('','');

  const {data,error}=await supabaseClient.auth.signUp({
    email,password,
    options:{data:{full_name:name,role,age_group:age}}
  });
  if(error){setAuthMessage('error',friendlyAuthError(error));return}

  if(data.session){
    currentUser=data.user;
    try{
      await saveProfile({name,type:role,age,church:'',service:'',email});
      hideAuthScreen();
      await loadAllData();
      toast('تم إنشاء الحساب بنجاح ✨');
    }catch(e){setAuthMessage('error',friendlyAuthError(e))}
  }else{
    setAuthMessage('success','تم إنشاء الحساب. افتح رسالة التأكيد التي وصلت إلى بريدك الإلكتروني، ثم ارجع وسجّل الدخول.');
    switchAuth('login');
  }
}

async function loadProfile(){
  if(!supabaseClient || !currentUser) return;
  const {data,error}=await supabaseClient.from('profiles').select('*').eq('id',currentUser.id).maybeSingle();
  if(error) throw error;
  if(data){
    account={
      name:data.full_name||'',
      type:normalizeRole(data.role||'leader'),
      age:data.age_group||'',
      church:data.church||'',
      service:data.service_name||'',
      email:data.email||currentUser.email||''
    };
  }else{
    account={
      name:currentUser.user_metadata?.full_name||currentUser.email?.split('@')[0]||'مستخدم مِرْسَال',
      type:normalizeRole(currentUser.user_metadata?.role||'leader'),
      age:currentUser.user_metadata?.age_group||'',
      church:'',
      service:'',
      email:currentUser.email||''
    };
    await saveProfile(account);
  }
  userId=currentUser.id;
  renderAccount();
}

async function saveProfile(a){
  if(!supabaseClient || !currentUser) return;
  const payload={
    id:currentUser.id,
    full_name:a.name||'',
    role:normalizeRole(a.type||'leader'),
    age_group:a.age||'',
    church:a.church||'',
    service_name:a.service||'',
    email:currentUser.email||a.email||''
  };
  const {data,error}=await supabaseClient.from('profiles').upsert(payload).select().single();
  if(error) throw error;
  account={
    name:data.full_name||'',type:normalizeRole(data.role||'leader'),age:data.age_group||'',
    church:data.church||'',service:data.service_name||'',
    email:data.email||currentUser.email||''
  };
  userId=currentUser.id;
}

async function saveAccount(){
  if(!currentUser){showAuthScreen();return}
  const next={
    name:document.getElementById('editName').value.trim()||'مستخدم مِرْسَال',
    type:document.getElementById('editType').value,
    age:document.getElementById('editAge').value,
    church:document.getElementById('editChurch').value.trim(),
    service:document.getElementById('editService').value.trim(),
    email:currentUser.email||''
  };
  try{
    await saveProfile(next);
    closeModal(); renderAccount(); toast('تم حفظ بيانات الحساب في قاعدة البيانات ✨');
  }catch(error){toast('تعذر حفظ البيانات: '+friendlyAuthError(error))}
}

async function logout(){
  if(!supabaseClient) return;
  const {error}=await supabaseClient.auth.signOut();
  if(error){toast(friendlyAuthError(error));return}
  currentUser=null;userId='';
  account={name:'',type:'leader',age:'',church:'',service:'',email:''};
  lessons=[];students=[];
  showAuthScreen();switchAuth('login');
  toast('تم تسجيل الخروج');
}

async function initAuth(){
  if(!supabaseClient){
    showAuthScreen();
    setAuthMessage('error','تعذر تشغيل Supabase في هذه الصفحة. تأكد من اتصال الإنترنت.');
    return;
  }
  const {data,error}=await supabaseClient.auth.getSession();
  if(error){showAuthScreen();setAuthMessage('error',friendlyAuthError(error));return}
  currentUser=data.session?.user||null;
  if(currentUser){
    try{await loadProfile();hideAuthScreen();await loadAllData();}
    catch(e){showAuthScreen();setAuthMessage('error',friendlyAuthError(e))}
  }else showAuthScreen();

  supabaseClient.auth.onAuthStateChange(async (_event,session)=>{
    currentUser=session?.user||null;
    if(currentUser){
      try{
        await loadProfile();
        hideAuthScreen();
        await loadAllData();
      }catch(e){showAuthScreen();setAuthMessage('error',friendlyAuthError(e))}
    }else showAuthScreen();
  });
}

/* =========================
   DATA — real Supabase CRUD
   ========================= */
async function loadAllData(){
  if(!currentUser) return;
  await Promise.all([loadLessons(),loadStudents(),loadSpiritual(),loadNotes(),loadAttendance(),loadCalendar().catch(()=>{window.calendarAvailable=false;window.calendarEvents=[];})]);
  renderDashboard();
  renderLessons();
  renderStudents();
  renderChart();
  renderAccount();
}

async function loadLessons(){
  const {data,error}=await supabaseClient.from('lessons')
    .select('*').order('updated_at',{ascending:false});
  if(error) throw error;
  lessons=data||[];
}
async function loadStudents(){
  const {data,error}=await supabaseClient.from('students')
    .select('*').order('created_at',{ascending:false});
  if(error) throw error;
  students=data||[];
}
async function loadSpiritual(){
  const {data,error}=await supabaseClient.from('spiritual_activities')
    .select('*').order('activity_date',{ascending:false}).order('created_at',{ascending:false});
  if(error) throw error;
  window.spiritualActivities=data||[];
}
async function loadNotes(){
  const {data,error}=await supabaseClient.from('notes')
    .select('*').order('updated_at',{ascending:false});
  if(error) throw error;
  window.userNotes=data||[];
}
async function loadAttendance(){
  const {data,error}=await supabaseClient.from('attendance')
    .select('*').order('attendance_date',{ascending:false});
  if(error) throw error;
  window.attendanceRecords=data||[];
}

function show(id,btn){
  document.querySelectorAll('.section').forEach(x=>x.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));
  if(btn) btn.classList.add('active');
  if(id==='prep') renderLessons();
  if(id==='bible' && !document.getElementById('bibleBook').options.length) initBible();
  if(id==='students') renderStudents();
  if(id==='spiritual') renderChart();
  if(id==='account') renderAccount();
  if(id==='dashboard') renderDashboard();
  if(id==='network') renderNetwork();
  if(id==='calendar') renderCalendar();
  window.scrollTo({top:0,behavior:'smooth'});
}

function formatLastUpdate(date){
  if(!date)return 'بدون تاريخ';
  const d=new Date(date),diff=Math.floor((Date.now()-d.getTime())/86400000);
  if(diff<=0)return 'اليوم'; if(diff===1)return 'منذ يوم'; return `منذ ${diff} أيام`;
}

function renderDashboard(){
  const prep=document.getElementById('prepCount');
  const studentCount=document.getElementById('studentCount');
  if(prep) prep.textContent=lessons.filter(x=>x.user_id===userId).length;
  if(studentCount) studentCount.textContent=students.length;
  const dashboardStudents=document.getElementById('dashboardStudentCount');
  if(dashboardStudents) dashboardStudents.textContent=students.length;
  const spiritual=window.spiritualActivities||[];
  const last7=new Set(spiritual.map(x=>x.activity_date));
  const streak=calculateStreak(spiritual);
  const s=document.getElementById('dashboardStreak');
  if(s) s.textContent=streak+' 🔥';
  const saved=document.getElementById('savedNoteCount');
  if(saved) saved.textContent=(window.userNotes||[]).length;
  const dash=document.getElementById('dashboardLessons');
  if(dash){
    const own=lessons.filter(x=>x.user_id===userId).slice(0,2);
    dash.innerHTML=own.length?own.map(x=>`<div class=\"lesson\"><div class=\"row between\"><div><b>${escapeHtml(x.title)}</b><div class=\"muted\">${escapeHtml(x.age_group||'')} • ${escapeHtml(x.duration||'')}</div></div><span class=\"tag\">${formatLastUpdate(x.updated_at)}</span></div><p>${escapeHtml(x.description||x.main_points||'')}</p><button class=\"btn\" onclick=\"openLesson('${escapeAttr(x.id)}')\">فتح التحضير</button></div>`).join(''):'<div class=\"muted\" style=\"padding:15px 0\">لا توجد تحضيرات بعد. أنشئ أول تحضير من «مستر التحضير».</div>';
  }
  const reminder=document.getElementById('serviceReminder');
  if(reminder){
    const weekAgo=new Date(Date.now()-7*86400000);
    const pending=students.filter(s=>!s.last_contact_at || new Date(s.last_contact_at)<weekAgo).length;
    reminder.textContent=pending?`لديك ${pending} مخدوم لم يتم التواصل معه خلال آخر 7 أيام.`:'كل المخدومين لديهم متابعة حديثة خلال آخر 7 أيام. ✨';
  }
  const weekly=document.getElementById('weeklyProgress');
  if(weekly){
    const pct=Math.min(100,Math.round(last7.size/7*100));
    weekly.style.width=pct+'%';
    const label=document.getElementById('weeklyProgressText');
    if(label) label.textContent=pct+'% من أيام الأسبوع فيها نشاط';
  }
}

function renderLessons(arr=lessons){
  const list=document.getElementById('lessonList');
  if(!list)return;
  if(!arr.length){
    list.innerHTML='<div class="muted" style="padding:25px;text-align:center">لا توجد تحضيرات محفوظة بعد. اضغط «تحضير جديد» لإضافة أول تحضير.</div>';
    return;
  }
  list.innerHTML=arr.map(x=>{
    const owner=x.user_id===userId;
    return `<div class="lesson">
      <div class="row between">
        <div><b>${escapeHtml(x.title)}</b><div class="muted">${escapeHtml(x.age_group||'')} • ${escapeHtml(x.duration||'')}</div></div>
        <span class="tag">${owner?'تحضير شخصي':'تحضير مشترك'}</span>
      </div>
      <p>${escapeHtml(x.description||x.main_points||'')}</p>
      <button class="btn" onclick="openLesson('${escapeAttr(x.id)}')">فتح</button>
      ${owner?`<button class="btn secondary" onclick="editLesson('${escapeAttr(x.id)}')">تعديل</button>
      <button class="btn logout-btn" onclick="deleteLesson('${escapeAttr(x.id)}')">حذف</button>`:''}
    </div>`;
  }).join('');
}
function filterLessons(){
  const q=document.getElementById('topicSearch').value.trim().toLowerCase();
  renderLessons(lessons.filter(x=>
    `${x.title||''} ${x.description||''} ${x.main_verse||''} ${x.main_points||''} ${x.application||''}`
      .toLowerCase().includes(q)));
}

function openLesson(id){
  const x=lessons.find(l=>l.id===id);
