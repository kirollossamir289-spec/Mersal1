<script>
/* Secure role-aware login: the database profile is authoritative. */
const _loginOriginal=login;
login=async function(event){
  event.preventDefault();
  const selected=document.getElementById('loginRole')?.value||'خادم';
  await _loginOriginal(event);
  if(currentUser && account?.type && normalizeRole(account.type)!==normalizeRole(selected)){
    await supabaseClient.auth.signOut(); currentUser=null; userId='';
    showAuthScreen();
    setAuthMessage('error',`نوع الحساب المختار (${selected}) لا يطابق نوع الحساب المسجل لهذا البريد.`);
  }
};
/* Robust login: do not let a secondary data-table error make a successful sign-in look like a failed login. */
login=async function(event){
  event.preventDefault();
  if(!supabaseClient){setAuthMessage('error','تعذر تشغيل Supabase.');return}
  const form=event.currentTarget;
  const btn=form?.querySelector('button[type=submit]');
  const email=document.getElementById('loginEmail').value.trim();
  const password=document.getElementById('loginPassword').value;
  const selected=document.getElementById('loginRole')?.value||'leader';
  if(!email||!password){setAuthMessage('error',document.documentElement.lang==='ar'?'اكتب البريد الإلكتروني وكلمة المرور أولًا.':'Enter your email and password first.');return}
  if(btn){btn.disabled=true;btn.textContent=document.documentElement.lang==='ar'?'جاري الدخول...':'Signing in...'}
  setAuthMessage('','');
  try{
    const {data,error}=await supabaseClient.auth.signInWithPassword({email,password});
    if(error)throw error;
    currentUser=data.user;
    await loadProfile();
    if(normalizeRole(account.type)!==normalizeRole(selected)){
      await supabaseClient.auth.signOut(); currentUser=null; userId='';
      showAuthScreen();
      setAuthMessage('error',document.documentElement.lang==='ar'?`نوع الحساب المختار (${roleLabel(selected)}) لا يطابق نوع الحساب المسجل لهذا البريد.`:`The selected account type (${roleLabel(selected)}) does not match this account.`);
      return;
    }
    hideAuthScreen();
    try{await loadAllData()}catch(dataError){
      console.error('MERSAL data load error after login',dataError);
      toast(document.documentElement.lang==='ar'?'تم تسجيل الدخول، لكن بعض البيانات تحتاج إعداد قاعدة البيانات.':'Signed in, but some data still needs database setup.');
    }
    applyRoleUI();
    renderAccount();
  }catch(error){
    showAuthScreen();
    setAuthMessage('error',friendlyAuthError(error));
  }finally{
    if(btn){btn.disabled=false;btn.textContent=document.documentElement.lang==='ar'?'تسجيل الدخول':'Sign In'}
  }
};

