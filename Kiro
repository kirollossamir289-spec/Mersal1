  const {data,error}=await supabaseClient.from('calendar_events').select('*').order('starts_at',{ascending:true});
  if(error){
    window.calendarAvailable=false;
    window.calendarEvents=[];
    return;
  }
  window.calendarAvailable=true;
  window.calendarEvents=data||[];
}
function calendarKey(d){return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
function renderCalendar(){
  const grid=document.getElementById('calendarGrid'), title=document.getElementById('calendarTitle'); if(!grid||!title)return;
  const y=calendarDate.getFullYear(), m=calendarDate.getMonth();
  title.textContent=calendarDate.toLocaleDateString(document.documentElement.lang==='ar'?'ar-EG':'en-US',{month:'long',year:'numeric'});
  const first=new Date(y,m,1), start=(first.getDay()+6)%7, days=new Date(y,m+1,0).getDate();
  const names=document.documentElement.lang==='ar'?['الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت','الأحد']:['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
  let html=names.map(n=>`<div class="calendar-head">${n}</div>`).join('');
  for(let i=0;i<start;i++) html+='<div class="calendar-day muted-day"></div>';
  const today=calendarKey(new Date());
  for(let d=1;d<=days;d++){
    const key=calendarKey(new Date(y,m,d)); const events=(window.calendarEvents||[]).filter(e=>calendarKey(new Date(e.starts_at))===key);
    html+=`<div class="calendar-day ${key===today?'today':''}" onclick="calendarDayClick('${key}')"><div class="calendar-date">${d}</div>${events.map(e=>`<div class="calendar-event"><b>${escapeHtml(e.title)}</b><small>${new Date(e.starts_at).toLocaleTimeString(document.documentElement.lang==='ar'?'ar-EG':'en-US',{hour:'numeric',minute:'2-digit'})}</small></div>`).join('')}</div>`;
  }
  grid.innerHTML=html;
  const upcoming=(window.calendarEvents||[]).filter(e=>new Date(e.starts_at)>=new Date()).slice(0,10);
  const box=document.getElementById('upcomingEvents'); box.innerHTML=upcoming.length?upcoming.map(e=>`<div class="person"><div class="mini">📅</div><div style="flex:1"><b>${escapeHtml(e.title)}</b><div class="muted">${new Date(e.starts_at).toLocaleString(document.documentElement.lang==='ar'?'ar-EG':'en-US')}</div>${e.description?`<div class="muted">${escapeHtml(e.description)}</div>`:''}</div>${isLeader()?`<button class="btn secondary" onclick="deleteCalendarEvent('${escapeAttr(e.id)}')">Delete</button>`:''}</div>`).join(''):'<div class="muted">No upcoming events.</div>';
  const add=document.getElementById('calendarAddBtn'); if(add)add.style.display=isLeader()?'':'none';
}
function calendarPrevMonth(){calendarDate=new Date(calendarDate.getFullYear(),calendarDate.getMonth()-1,1);renderCalendar()}
function calendarNextMonth(){calendarDate=new Date(calendarDate.getFullYear(),calendarDate.getMonth()+1,1);renderCalendar()}
function calendarDayClick(key){if(isLeader())newCalendarEvent(key);}
function newCalendarEvent(dateKey=''){
  if(!isLeader()){toast(document.documentElement.lang==='ar'?'القادة فقط يمكنهم إضافة أحداث للتقويم':'Only leaders can add calendar events');return}
  const ar=document.documentElement.lang==='ar'; document.getElementById('modalBox').innerHTML=`<h2>${ar?'إضافة حدث في التقويم':'Add Calendar Event'} 📅</h2><div class="field"><label>${ar?'العنوان':'Title'}</label><input id="eventTitle" required placeholder="${ar?'نادي كشفي':'Scout Club'}"></div><br><div class="field"><label>${ar?'التاريخ':'Date'}</label><input id="eventDate" type="date" value="${dateKey||calendarKey(calendarDate)}"></div><br><div class="field"><label>${ar?'الوقت':'Time'}</label><input id="eventTime" type="time" value="18:00"></div><br><div class="field"><label>${ar?'الوصف':'Description'}</label><textarea id="eventDescription" rows="3"></textarea></div><br><button class="btn" onclick="saveCalendarEvent()">${ar?'حفظ الحدث':'Save Event'}</button> <button class="btn secondary" onclick="closeModal()">${ar?'إلغاء':'Cancel'}</button>`;
  document.getElementById('modal').classList.add('show');
}
async function saveCalendarEvent(){
  if(!isLeader())return;
  const date=document.getElementById('eventDate').value,time=document.getElementById('eventTime').value;
  if(!date||!time||!document.getElementById('eventTitle').value.trim()){toast('Please complete the event details');return}
  const {error}=await supabaseClient.from('calendar_events').insert({created_by:userId,title:document.getElementById('eventTitle').value.trim(),description:document.getElementById('eventDescription').value.trim(),starts_at:`${date}T${time}:00`});
  if(error){toast('Could not save event: '+friendlyAuthError(error));return}
  await loadCalendar();closeModal();renderCalendar();toast(document.documentElement.lang==='ar'?'تمت إضافة الحدث ✨':'Event added ✨');
}
async function deleteCalendarEvent(id){
  if(!isLeader())return;
  if(!confirm(document.documentElement.lang==='ar'?'حذف هذا الحدث؟':'Delete this event?'))return;
  const {error}=await supabaseClient.from('calendar_events').delete().eq('id',id); if(error){toast('Could not delete event: '+friendlyAuthError(error));return}
  await loadCalendar();renderCalendar();toast(document.documentElement.lang==='ar'?'تم حذف الحدث':'Event deleted');
}

